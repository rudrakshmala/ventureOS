# ═══ DATABASE ═══
DATABASE_URL=file:./venture.db

# ═══ LLM PROVIDERS ═══
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# ═══ EMAIL SENDING ═══
RESEND_API_KEY=re_...
# Domain you own — must have SPF + DKIM configured
SENDING_DOMAIN=ventures.yourdomain.com
SENDER_NAME=Rudraksh
# Max cold emails per day — start at 50, increase after 2 weeks
EMAIL_DAILY_LIMIT=50

# ═══ IMAP (reply monitoring) ═══
IMAP_HOST=imap.gmail.com
IMAP_USER=your@email.com
IMAP_PASS=your_app_password

# ═══ LEAD SOURCING ═══
# Apollo.io — free tier gives 50 credits/month
APOLLO_API_KEY=

# ═══ NOTIFICATIONS ═══
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══ PAYMENTS ═══
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ═══ APP ═══
APP_URL=https://yourdomain.com
PORT=3000
NODE_ENV=production

# ═══ FRONTEND ═══
NEXT_PUBLIC_API_URL=http://localhost:3000
