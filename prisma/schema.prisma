// 📄 prisma/schema.prisma — VentureOS Production Database Schema v2.0

datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

// ─── CORE TENANT & PROJECT MODELS ───────────────────────────────────────────

model Tenant {
  id        String    @id
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id                 String   @id @default(uuid())
  tenantId           String
  projectName        String
  workspacePath      String
  corporateDirective String
  status             String   // "PENDING", "SUCCESS", "FAILED"
  dealId             String?  @unique // Link to a signed business deal
  testStdout         String?
  testStderr         String?
  healingAttempts    Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audits             Audit[]
  deal               Deal?    @relation(fields: [dealId], references: [id])
}

model Audit {
  id            String   @id @default(uuid())
  projectId     String
  department    String
  statusMessage String
  savedFiles    String
  metricsText   String
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── BUSINESS INTELLIGENCE — LEAD MODELS ────────────────────────────────────

model Lead {
  id             String   @id @default(uuid())
  source         String   // "reddit", "hackernews", "producthunt", "twitter"
  sourceUrl      String?
  authorUsername String
  contactEmail   String?
  postTitle      String
  postContent    String
  painPoint      String?  // AI-extracted core pain point
  budgetSignal   String   @default("unknown") // "low","medium","high","unknown"
  niche          String?  // "saas","ecommerce","ai","automation","web","mobile"
  score          Int      @default(0)  // 0-100 opportunity score
  status         String   @default("NEW") // "NEW","PITCHED","REPLIED","WON","LOST","IGNORED"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  outreachCampaigns OutreachCampaign[]
  deal              Deal?
}

// ─── SALES & OUTREACH MODELS ─────────────────────────────────────────────────

model OutreachCampaign {
  id        String    @id @default(uuid())
  leadId    String
  sequence  Int       @default(1) // 1=initial pitch, 2=day2 followup, 3=day5, 4=day10 final
  subject   String
  body      String
  status    String    @default("DRAFT") // "DRAFT","SENT","DELIVERED","REPLIED","BOUNCED"
  sentAt    DateTime?
  repliedAt DateTime?
  replyBody String?   // What the lead replied with
  createdAt DateTime  @default(now())

  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

// ─── DEAL PIPELINE MODELS ────────────────────────────────────────────────────

model Deal {
  id          String    @id @default(uuid())
  leadId      String    @unique
  title       String
  value       Float     @default(0)
  currency    String    @default("USD")
  status      String    @default("NEGOTIATING") // "NEGOTIATING","WON","LOST","DELIVERED","PAID"
  proposalText String?  // The full proposal document sent to the client
  closedAt    DateTime?
  deliveredAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lead        Lead      @relation(fields: [leadId], references: [id])
  invoices    Invoice[]
  project     Project?
}

// ─── REVENUE MODELS ──────────────────────────────────────────────────────────

model Invoice {
  id          String    @id @default(uuid())
  dealId      String
  amount      Float
  currency    String    @default("USD")
  status      String    @default("UNPAID") // "UNPAID","SENT","PAID","OVERDUE"
  dueDate     DateTime?
  paidAt      DateTime?
  invoiceText String    // Full formatted invoice content
  createdAt   DateTime  @default(now())

  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

// ─── OPERATIONS & ANALYTICS MODELS ───────────────────────────────────────────

model AgentRunLog {
  id          String    @id @default(uuid())
  runType     String    // "EMPIRE_CYCLE","SCOUT_RUN","PITCH_RUN","DELIVERY_RUN","REVENUE_SYNC"
  status      String    @default("RUNNING") // "RUNNING","SUCCESS","FAILED"
  leadsFound  Int       @default(0)
  pitchesSent Int       @default(0)
  dealsWon    Int       @default(0)
  revenue     Float     @default(0)
  logs        String    @default("")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model GrowthInsight {
  id           String   @id @default(uuid())
  projectId    String?
  winFactor    String?  // What contributed to a win
  lossFactor   String?  // What caused a loss
  bestNiche    String?  // Top performing niche this cycle
  bestPlatform String?  // Top performing lead platform
  avgDealValue Float    @default(0)
  insights     String   // Full AI-generated analysis
  createdAt    DateTime @default(now())
}

// ─── INTER-AGENT MEMORY BUS ──────────────────────────────────────────────────

model MemoryBus {
  id        String   @id @default(uuid())
  agentId   String
  key       String
  value     String
  scope     String   @default("global")
  createdAt DateTime @default(now())
  ttl       Int?
}

model AgentMemory {
  id        String   @id @default(cuid())
  agentId   String
  key       String
  value     String   // JSON string
  scope     String   // 'global' | 'sales' | 'engineering' | 'devops' | 'security' | 'qa' | 'executive'
  ttl       Int?     // seconds until expiry, null = permanent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, key])
  @@index([agentId])
  @@map("agent_memory")
}

model EmailQuota {
  id        String   @id @default(cuid())
  date      String   // YYYY-MM-DD
  sent      Int      @default(0)
  maxDaily  Int      @default(100)
  createdAt DateTime @default(now())

  @@unique([date])
  @@map("email_quota")
}

model SalesLead {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  company     String?
  title       String?
  linkedinUrl String?
  source      String   // 'apollo' | 'csv' | 'manual'
  status      String   @default("sourced")
  // sourced -> emailed -> follow_up_1 -> follow_up_2 -> replied -> closed_won -> closed_lost
  painPoint   String?
  pitchSent   String?  // the actual email content sent
  repliedAt   DateTime?
  replyPreview String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@map("sales_leads")
}

model SalesProject {
  id          String   @id @default(cuid())
  clientEmail String
  clientName  String?
  brief       String   // what the client wants built
  status      String   @default("intake")
  // intake -> scoping -> building -> qa -> deploying -> delivered -> paid
  priceQuoted Int?     // in INR paise (smallest unit)
  paidAmount  Int?
  workspaceId String?
  deployedUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("sales_projects")
}

model Payment {
  id              String   @id @default(cuid())
  projectId       String
  razorpayOrderId String?
  razorpayPaymentId String?
  amount          Int      // in INR paise
  status          String   @default("pending")
  // pending -> paid -> refunded -> failed
  type            String   // '50_upfront' | '50_completion' | 'full'
  createdAt       DateTime @default(now())

  @@map("payments")
}